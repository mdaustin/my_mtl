<%= form_with(model: [@tier_list.user, @tier_list, @tier_list.tiers.build], local: true) do |form| %>
  <%= render 'shared/error_messages', object: tier %>
  <div class="flex gap-2">
    <%= form.label :title, "New tier name", class: "sr-only" %>
    <%= form.text_field :title, placeholder: "Add a tier, e.g. \"S\" or \"Must watch\"", class: "field-input" %>
    <%= form.button type: "submit", class: "btn-secondary shrink-0" do %>
      <%= icon(:plus, class: "size-4") %> Add tier
    <% end %>
  </div>
<% end %>

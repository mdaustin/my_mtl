<% owner = current_user == @tier_list.user %>
<% search_results = tier.title == "Search Results" %>
<li <% if owner %>data-sortable-update-url="<%= sort_user_tier_list_tier_path(@tier_list.user, @tier_list, tier) %>"<% end %> class="list-none">
  <%= turbo_frame_tag "tier-#{tier.id}" do %>
    <div class="flex gap-2 <%= 'cursor-grab active:cursor-grabbing' if owner && !search_results %>">
      <% unless search_results %>
        <div class="tier-label group/label relative flex w-20 shrink-0 items-center justify-center rounded-xl p-2 text-center sm:w-28">
          <h3 class="font-display text-base font-extrabold break-words text-zinc-950 sm:text-lg"><%= tier.title %></h3>
          <% if owner %>
            <%= link_to user_tier_list_tier_path(@tier_list.user, @tier_list, tier), data: { "turbo-method": :delete, turbo_confirm: "Are you sure you want to delete #{tier.title}?" }, class: "absolute top-1 right-1 rounded-md p-0.5 text-zinc-950/60 opacity-0 transition group-hover/label:opacity-100 hover:bg-black/10 hover:text-zinc-950 focus:opacity-100", title: "Delete tier" do %>
              <%= icon(:x, class: "size-4") %><span class="sr-only">Delete <%= tier.title %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <div <% if owner %>data-controller="sortable" data-sortable-group-value="tier_movies" data-sortable-tier-id="<%= tier.id %>"<% end %>
           class="flex min-h-28 flex-1 flex-wrap content-start gap-2 rounded-xl bg-white p-2 ring-1 ring-zinc-200 dark:bg-zinc-900 dark:ring-white/10
                  not-has-[>*]:content-center not-has-[>*]:justify-center not-has-[>*]:before:text-sm not-has-[>*]:before:text-zinc-400
                  <%= owner ? "not-has-[>*]:before:content-['Drag_movies_here']" : "not-has-[>*]:before:content-['Empty']" %>"><% tier.tier_movies.rank(:row_order).each do |tier_movie| %><%= render partial: "tier_movies/tier_movie", locals: { tier_movie: tier_movie, tier: tier } %><% end %></div>
    </div>
  <% end %>
</li>

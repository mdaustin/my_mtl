<div class="flex flex-wrap items-center justify-between gap-3">
  <h2 class="text-xl font-bold text-zinc-900 dark:text-white">Add movies</h2>
  <%= image_tag 'TMDBLogoLong.svg', alt: "The Movie Database", class: "h-3 opacity-80" %>
</div>

<%= form_with url: search_movies_path(user_id: @user.id, tier_list_id: @tier_list.id),
              method: :get,
              local: true,
              class: "mt-4",
              data: { turbo_frame: 'search_results' } do %>
  <div class="flex gap-2">
    <div class="relative flex-1">
      <%= label_tag :query, "Search for a movie", class: "sr-only" %>
      <%= icon(:search, class: "pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-zinc-400") %>
      <%= text_field_tag :query, params[:query], placeholder: "Search for a movie…", class: "field-input pl-9" %>
    </div>
    <%= submit_tag "Search", class: "btn-primary" %>
  </div>
<% end %>

<turbo-frame id='search_results' class="mt-4 block">
  <%= render 'movies/results' %>
</turbo-frame>

<% @user ||= current_user %>
<div class="flex items-center gap-5 text-sm">
    <a href="<%= following_user_path(@user) %>" class="muted hover:text-zinc-900 dark:hover:text-white">
        <strong id="following" class="font-semibold text-zinc-900 dark:text-white"><%= @user.following.count %></strong>
        following
    </a>
    <a href="<%= followers_user_path(@user) %>" class="muted hover:text-zinc-900 dark:hover:text-white">
        <strong id="followers" class="font-semibold text-zinc-900 dark:text-white"><%= @user.followers.count %></strong>
        followers
    </a>
</div>

<% if object.errors.any? %>
  <div class="flex gap-3 rounded-xl bg-red-50 p-4 ring-1 ring-red-200 dark:bg-red-950/50 dark:ring-red-900">
    <%= icon(:alert, class: "size-5 shrink-0 text-red-500 dark:text-red-400") %>
    <div>
      <h3 class="font-sans text-sm font-semibold tracking-normal text-red-800 dark:text-red-200">
        There <%= object.errors.count == 1 ? "is" : "are" %> <%= pluralize(object.errors.count, "error") %> in your submission
      </h3>
      <ul role="list" class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700 dark:text-red-300">
        <% object.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>

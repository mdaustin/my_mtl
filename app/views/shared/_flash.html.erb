<div class="pointer-events-none fixed inset-x-0 top-20 z-50 flex flex-col items-center gap-2 px-4 sm:items-end sm:px-6">
  <% flash.each do |key, value| %>
    <div data-controller="flash" role="status"
         class="pointer-events-auto flex w-full max-w-sm items-start gap-3 rounded-xl p-4 text-sm shadow-lg ring-1 <%= css_for_flash_key(key) %>">
      <%= icon(flash_icon(key), class: "size-5 shrink-0") %>
      <p class="flex-1 font-medium"><%= value %></p>
      <button type="button" data-action="flash#dismiss" class="shrink-0 opacity-60 hover:opacity-100" aria-label="Dismiss">
        <%= icon(:x, class: "size-5") %>
      </button>
    </div>
  <% end %>
</div>

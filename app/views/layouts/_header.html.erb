<header class="sticky top-0 z-40 border-b border-zinc-200 bg-white/80 backdrop-blur-lg dark:border-white/10 dark:bg-zinc-950/80">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <div class="flex items-center gap-6">
      <a href="<%= root_path %>" class="flex items-center gap-2 font-display text-lg font-bold text-zinc-900 dark:text-white">
        <span class="flex size-8 items-center justify-center rounded-lg bg-amber-400 text-zinc-950">
          <%= icon(:film, class: "size-5") %>
        </span>
        MyMTL
      </a>

      <!-- primary nav -->
      <div class="hidden items-center gap-1 md:flex">
        <a href="<%= root_path %>" class="<%= nav_link_class(root_path) %>">Home</a>
        <% if !logged_in? %>
          <a href="<%= about_path %>" class="<%= nav_link_class(about_path) %>">About</a>
          <a href="<%= help_path %>" class="<%= nav_link_class(help_path) %>">Help</a>
        <% end %>
      </div>
    </div>

    <!-- secondary nav -->
    <div class="hidden items-center gap-1 md:flex">
      <% if logged_in? %>
        <%= link_to users_path, class: nav_link_class(users_path) do %>
          <%= icon(:users, class: "size-4") %> Users
        <% end %>
        <%= link_to current_user, class: nav_link_class(user_path(current_user)) do %>
          <%= icon(:squares, class: "size-4") %> My Tier Lists
        <% end %>
        <%= link_to edit_user_path(current_user), class: nav_link_class(edit_user_path(current_user)), title: "Settings" do %>
          <%= icon(:cog, class: "size-4") %> <span class="sr-only lg:not-sr-only">Settings</span>
        <% end %>
        <%= link_to logout_path, data: { "turbo-method": :delete }, class: "nav-link", title: "Log out" do %>
          <%= icon(:logout, class: "size-4") %> <span class="sr-only lg:not-sr-only">Log out</span>
        <% end %>
        <span class="ml-2"><%= avatar(current_user, size: "size-8 text-xs") %></span>
      <% else %>
        <a href="<%= login_path %>" class="btn-ghost">Log in</a>
        <a href="<%= signup_path %>" class="btn-primary">Sign up</a>
      <% end %>
    </div>

    <!-- mobile button -->
    <button id="mobile-button" type="button" class="rounded-lg p-2 text-zinc-600 hover:bg-zinc-100 md:hidden dark:text-zinc-300 dark:hover:bg-white/5" aria-label="Toggle menu">
      <%= icon(:menu, class: "size-6") %>
      <%= icon(:x, class: "size-6 hidden") %>
    </button>
  </nav>

  <!-- mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-zinc-200 px-4 py-3 md:hidden dark:border-white/10">
    <div class="space-y-1">
      <a href="<%= root_path %>" class="mobile-nav-link"><%= icon(:home) %> Home</a>
      <%= link_to about_path, class: "mobile-nav-link" do %><%= icon(:info) %> About<% end %>
      <%= link_to help_path, class: "mobile-nav-link" do %><%= icon(:check) %> Help<% end %>
    </div>

    <div class="my-3 border-t border-zinc-200 dark:border-white/10"></div>

    <% if logged_in? %>
      <div class="space-y-1">
        <%= link_to users_path, class: "mobile-nav-link" do %><%= icon(:users) %> Users<% end %>
        <%= link_to current_user, class: "mobile-nav-link" do %><%= icon(:squares) %> My Tier Lists<% end %>
        <%= link_to edit_user_path(current_user), class: "mobile-nav-link" do %><%= icon(:cog) %> Settings<% end %>
        <%= link_to logout_path, data: { "turbo-method": :delete }, class: "mobile-nav-link" do %><%= icon(:logout) %> Log out<% end %>
      </div>
    <% else %>
      <div class="grid grid-cols-2 gap-2">
        <%= link_to 'Log in', login_path, class: "btn-secondary" %>
        <%= link_to 'Sign up', signup_path, class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</header>

<div class="group relative <%= current_user == @tier_list.user ? 'cursor-grab active:cursor-grabbing' : '' %>" data-sortable-id="<%= tier_movie.id %>" data-sortable-update-url="<%= sort_user_tier_list_tier_tier_movie_path(@tier_list.user, @tier_list, tier, tier_movie.id)%>">
  <% if current_user == @tier_list.user %>
    <%= link_to user_tier_list_tier_tier_movie_path(@tier_list.user, @tier_list, tier, tier_movie), data: { "turbo-method": :delete, turbo_confirm: "Are you sure you want to delete this movie?"}, class: "absolute -top-1.5 -right-1.5 z-20 rounded-full bg-zinc-900 p-0.5 text-white opacity-0 shadow ring-2 ring-white transition group-hover:opacity-100 focus:opacity-100 dark:ring-zinc-900", title: "Remove movie" do %>
      <%= icon(:x, class: "size-3.5") %><span class="sr-only">Remove <%= tier_movie.movie.title %></span>
    <% end %>
  <% end %>

  <div class="relative" data-controller="hovercard"
       data-hovercard-url-value="<%= hovercard_user_tier_list_tier_tier_movie_path(@tier_list.user, @tier_list, tier, tier_movie) %>"
       data-action="mouseenter->hovercard#show mouseleave->hovercard#hide">
    <%= render 'movies/poster', movie: tier_movie.movie,
               class: "w-16 rounded-lg shadow-sm ring-1 ring-black/5 transition duration-200 group-hover:-translate-y-0.5 group-hover:shadow-md sm:w-20" %>
  </div>
</div>

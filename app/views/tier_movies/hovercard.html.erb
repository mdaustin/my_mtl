<div class="pointer-events-none absolute bottom-full left-1/2 z-50 mb-3 w-72 -translate-x-1/2" data-hovercard-target="card">
    <div class="card flex gap-4 p-3 shadow-xl">
        <%= render 'movies/poster', movie: @tier_movie.movie, size: "w342", compact: true, class: "w-24 shrink-0 rounded-lg" %>
        <div class="min-w-0 py-1">
            <h4 class="font-display text-base leading-tight font-bold text-zinc-900 dark:text-white"><%= @tier_movie.movie.title %></h4>
            <p class="mt-1 text-xs muted"><%= @tier_movie.movie.release_date&.year %> · <%= @tier_movie.movie.runtime %> min</p>
            <p class="mt-2 line-clamp-5 text-xs text-zinc-600 dark:text-zinc-300"><%= @tier_movie.movie.overview %></p>
        </div>
    </div>
</div>

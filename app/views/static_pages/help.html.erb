<% provide(:title, "Help") %>
<div class="mx-auto max-w-3xl">
  <h1 class="page-title">Help</h1>
  <p class="mt-3 text-lg muted">Everything you need to build your first tier list.</p>

  <div class="mt-10 space-y-4">
    <% [["How do I make a tier list?", "Open My Tier Lists and choose New tier list. Give it a title and a short description."],
        ["How do I add tiers?", "On your tier list, use the Add a tier box. Tiers are coloured by position, top to bottom."],
        ["How do I add movies?", "Search for a movie at the bottom of your tier list. Results appear in a row you can drag from."],
        ["How do I rank movies?", "Drag posters between tiers, or drag a whole tier to reorder it. Changes save automatically."],
        ["How do I follow people?", "Find someone on the Users page and press Follow on their profile. Their lists show up in your feed."]].each do |q, a| %>
      <details class="card group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between font-semibold text-zinc-900 dark:text-white">
          <%= q %>
          <%= icon(:plus, class: "size-5 shrink-0 text-zinc-400 transition group-open:rotate-45") %>
        </summary>
        <p class="mt-3 text-sm muted"><%= a %></p>
      </details>
    <% end %>
  </div>
</div>

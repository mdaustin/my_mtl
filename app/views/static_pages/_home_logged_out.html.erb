<!-- Hero -->
<section class="relative isolate grid items-center gap-12 py-6 lg:grid-cols-2 lg:py-12">
  <div aria-hidden="true" class="absolute -top-24 left-1/2 -z-10 h-72 w-[40rem] -translate-x-1/2 rounded-full bg-amber-400/20 blur-3xl dark:bg-amber-400/10"></div>

  <div class="text-center lg:text-left">
    <span class="inline-flex items-center gap-2 rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800 dark:bg-amber-400/10 dark:text-amber-300">
      <%= icon(:film, class: "size-4") %> Powered by TMDB
    </span>
    <h1 class="mt-6 text-5xl font-extrabold text-zinc-900 sm:text-6xl dark:text-white">
      Rank every movie <span class="text-amber-500 dark:text-amber-400">you've ever watched.</span>
    </h1>
    <p class="mt-6 text-lg muted">
      Build movie tier lists, drag films from S-tier to the bottom of the barrel, and see how your friends rank theirs.
    </p>
    <div class="mt-8 flex items-center justify-center gap-3 lg:justify-start">
      <a href="<%= signup_path %>" class="btn-primary px-6 py-3 text-base">Get started, it's free</a>
      <a href="<%= login_path %>" class="btn-ghost px-6 py-3 text-base">Log in &rarr;</a>
    </div>
  </div>

  <!-- Example tier list -->
  <div class="card p-4 sm:p-6" aria-hidden="true">
    <ul class="tier-stack space-y-2">
      <% [["S", 4], ["A", 5], ["B", 3], ["C", 2]].each do |label, count| %>
        <li class="flex overflow-hidden rounded-xl bg-zinc-100 dark:bg-white/5">
          <div class="tier-label flex w-14 shrink-0 items-center justify-center font-display text-xl font-extrabold text-zinc-950"><%= label %></div>
          <div class="flex flex-1 gap-2 p-2">
            <% count.times do |i| %>
              <div class="aspect-[2/3] w-10 rounded-md bg-linear-to-br sm:w-12 <%= %w[from-zinc-300 from-zinc-400 from-zinc-300 from-zinc-200 from-zinc-400][i] %> to-zinc-500 dark:from-zinc-700 dark:to-zinc-800"></div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</section>

<!-- Features -->
<section class="py-16">
  <h2 class="text-center text-3xl font-bold text-zinc-900 dark:text-white">Why MyMTL?</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    <% [[:film, "Full TMDB integration", "Search TMDB's huge catalogue and drop any film straight into your list."],
        [:share, "Connect with others", "Follow friends, browse their tier lists and argue about their taste."],
        [:chart, "Track your watching", "Keep the best and the worst in one place, with total runtime tallied up."]].each do |ic, title, body| %>
      <div class="card p-6">
        <span class="flex size-11 items-center justify-center rounded-xl bg-amber-100 text-amber-700 dark:bg-amber-400/10 dark:text-amber-300">
          <%= icon(ic, class: "size-6") %>
        </span>
        <h3 class="mt-4 text-lg font-semibold text-zinc-900 dark:text-white"><%= title %></h3>
        <p class="mt-2 text-sm muted"><%= body %></p>
      </div>
    <% end %>
  </div>
</section>

<li class="card flex items-center gap-3 p-4">
    <%= avatar(user) %>
    <div class="min-w-0 flex-1">
        <%= link_to user.username, user, class: "block truncate font-semibold text-zinc-900 hover:text-amber-600 dark:text-white dark:hover:text-amber-400" %>
        <p class="text-xs muted"><%= pluralize(user.tier_lists.size, "tier list") %></p>
    </div>
    <% if current_user.admin? && !current_user?(user) %>
        <%= link_to 'delete', user, data: { "turbo-frame": "search_results",
                                            "turbo-method": :delete,
                                            turbo_confirm: "Are you sure you want to delete #{user.username}?"},
                                            class: "rounded-lg px-2 py-1 text-xs font-medium text-rose-600 hover:bg-rose-50 dark:text-rose-400 dark:hover:bg-rose-950" %>
    <% end %>
</li>

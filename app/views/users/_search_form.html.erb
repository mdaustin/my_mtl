<%= form_tag(search_users_path, method: :get, remote: true, class: "flex w-full gap-2 sm:w-auto") do %>
    <div class="relative flex-1 sm:w-72">
        <%= icon(:search, class: "pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-zinc-400") %>
        <%= text_field_tag :search, params[:search], placeholder: "Search users", class: "field-input pl-9" %>
    </div>
    <%= submit_tag "Search", class: "btn-secondary" %>
<% end %>

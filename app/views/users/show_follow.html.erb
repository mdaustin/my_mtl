<% provide(:title, @title) %>
<div class="grid gap-8 lg:grid-cols-[18rem_1fr]">
    <aside class="card h-fit space-y-5 p-6">
        <%= link_to @user, class: "flex items-center gap-3" do %>
            <%= avatar(@user, size: "size-12 text-base") %>
            <span class="font-display text-xl font-bold text-zinc-900 hover:text-amber-600 dark:text-white dark:hover:text-amber-400"><%= @user.username %></span>
        <% end %>
        <dl class="grid grid-cols-2 gap-3 text-sm">
            <div class="rounded-xl bg-zinc-100 p-3 dark:bg-white/5">
                <dt class="muted">Tier lists</dt>
                <dd class="mt-1 text-lg font-semibold"><%= @user.tier_lists.count %></dd>
            </div>
            <div class="rounded-xl bg-zinc-100 p-3 dark:bg-white/5">
                <dt class="muted">Movies ranked</dt>
                <dd class="mt-1 text-lg font-semibold"><%= @user.total_ranked_movie_count %></dd>
            </div>
        </dl>
        <%= render 'shared/user_stats' %>
    </aside>

    <section>
        <div class="flex flex-wrap items-end justify-between gap-4">
            <h1 class="page-title"><%= @title %></h1>
            <%= render 'search_form' %>
        </div>
        <% if @users.any? %>
            <ul class="mt-6 grid gap-3 sm:grid-cols-2">
                <%= render @users %>
            </ul>
            <%= will_paginate %>
        <% else %>
            <div class="card mt-6 p-10 text-center"><p class="muted">Nobody here yet.</p></div>
        <% end %>
    </section>
</div>

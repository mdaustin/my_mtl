<%= form_with(model: @user, class: "space-y-5") do |f| %>
    <%= render 'shared/error_messages', object: f.object %>

    <div class="space-y-1.5">
        <%= f.label :username, class: "field-label" %>
        <%= f.text_field :username, placeholder: "Username", autocomplete: "username", class: "field-input" %>
    </div>

    <div class="space-y-1.5">
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, placeholder: "you@example.com", autocomplete: "email", class: "field-input" %>
    </div>

    <div class="space-y-1.5">
        <%= f.label :password, class: "field-label" %>
        <%= f.password_field :password, placeholder: "••••••••", autocomplete: "new-password", class: "field-input" %>
    </div>

    <div class="space-y-1.5">
        <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
        <%= f.password_field :password_confirmation, placeholder: "••••••••", autocomplete: "new-password", class: "field-input" %>
    </div>

    <%= f.submit yield(:button_text), class: "btn-primary w-full" %>
<% end %>

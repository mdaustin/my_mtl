<%= provide(:title, @user.username ) %>

<section class="card flex flex-col items-center gap-6 p-6 sm:flex-row sm:p-8">
  <%= avatar(@user, size: "size-20 text-2xl") %>
  <div class="flex-1 text-center sm:text-left">
    <h1 class="page-title"><%= @user.username %></h1>
    <div class="mt-3 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 sm:justify-start">
      <%= render 'shared/user_stats' %>
      <span class="text-sm muted"><strong class="font-semibold text-zinc-900 dark:text-white"><%= @user.total_ranked_movie_count %></strong> movies ranked</span>
    </div>
  </div>
  <div class="flex items-center gap-2">
    <%= render 'follow_form' if logged_in? %>
    <% if current_user?(@user) %>
      <%= link_to new_user_tier_list_path(@user), class: "btn-primary" do %>
        <%= icon(:plus, class: "size-4") %> New tier list
      <% end %>
    <% end %>
  </div>
</section>

<section class="mt-10">
  <h2 class="text-xl font-bold text-zinc-900 dark:text-white">
    Tier lists <span class="ml-1 text-base font-medium muted"><%= @user.tier_lists.count %></span>
  </h2>

  <% if @user.tier_lists.any? %>
    <ol class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <%= render @tier_lists %>
    </ol>
    <%= will_paginate @tier_lists %>
  <% else %>
    <div class="card mt-4 p-10 text-center">
      <p class="muted">No tier lists yet.</p>
    </div>
  <% end %>
</section>

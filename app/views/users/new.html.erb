<% provide(:title, 'Sign up') %>
<% provide(:button_text, 'Create account') %>

<div class="mx-auto max-w-md py-6">
  <div class="text-center">
    <h1 class="page-title">Create your account</h1>
    <p class="mt-2 muted">Start ranking movies in under a minute.</p>
  </div>

  <div class="card mt-8 p-6 sm:p-8">
    <%= render 'form' %>
  </div>

  <p class="mt-6 text-center text-sm muted">Already have an account? <%= link_to "Log in", login_path, class: 'link' %></p>
</div>

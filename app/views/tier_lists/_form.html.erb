<%= form_with(model: @tier_list, url: @tier_list.new_record? ? user_tier_lists_path(current_user) : user_tier_list_path(current_user, @tier_list), class: "space-y-5") do |f| %>
    <%= render 'shared/error_messages', object: f.object %>
    <div class="space-y-1.5">
        <%= f.label :title, class: "field-label" %>
        <%= f.text_field :title, placeholder: "e.g. Every Nolan film, ranked", class: "field-input" %>
    </div>
    <div class="space-y-1.5">
        <%= f.label :description, class: "field-label" %>
        <%= f.text_area :description, rows: 3, placeholder: "Describe your tier list...", class: "field-input" %>
        <p class="text-xs muted">Up to 160 characters.</p>
    </div>
    <%= f.submit @tier_list.new_record? ? "Create tier list" : "Save changes", class: "btn-primary w-full" %>
<% end %>

<% provide(:title, "Edit tier list") %>
<div class="mx-auto max-w-lg py-6">
  <h1 class="page-title">Edit tier list</h1>

  <div class="card mt-8 p-6 sm:p-8">
    <%= render "form", tier_list: @tier_list %>
  </div>

  <div class="mt-6 flex gap-4 text-sm">
    <%= link_to "View tier list", user_tier_list_path(@tier_list.user, @tier_list), class: "link" %>
    <%= link_to "Back to your tier lists", @tier_list.user, class: "link" %>
  </div>
</div>

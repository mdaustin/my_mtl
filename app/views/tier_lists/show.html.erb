<% provide(:title, @tier_list.title) %>
<% owner = current_user == @tier_list.user %>

<header class="flex flex-wrap items-start justify-between gap-6">
  <div class="min-w-0">
    <%= link_to @tier_list.user, class: "inline-flex items-center gap-2 text-sm muted hover:text-zinc-900 dark:hover:text-white" do %>
      <%= avatar(@tier_list.user, size: "size-6 text-[0.65rem]") %> <%= @tier_list.user.username %>
    <% end %>
    <h1 class="page-title mt-2"><%= @tier_list.title %></h1>
    <p class="mt-2 max-w-2xl muted"><%= @tier_list.description %></p>
    <div class="mt-4 flex flex-wrap gap-2 text-xs font-medium">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-3 py-1 text-zinc-700 dark:bg-white/5 dark:text-zinc-300">
        <%= icon(:film, class: "size-4") %> <%= pluralize(@tier_list.total_movie_count, "movie") %>
      </span>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-zinc-100 px-3 py-1 text-zinc-700 dark:bg-white/5 dark:text-zinc-300" title="<%= @tier_list.total_runtime %> minutes">
        <%= icon(:clock, class: "size-4") %> <%= @tier_list.total_runtime_hours %>h <%= @tier_list.total_runtime % 60 %>m total runtime
      </span>
    </div>
  </div>
  <% if owner %>
    <%= link_to edit_user_tier_list_path(@tier_list.user, @tier_list), class: "btn-secondary" do %>
      <%= icon(:pencil, class: "size-4") %> Edit details
    <% end %>
  <% end %>
</header>

<section class="mt-8">
  <% if owner %>
    <ul data-controller="sortable" id="tiers" class="tier-stack space-y-2">
      <% @tiers.rank(:row_order).each do |tier| %>
        <%= render tier unless tier.title == "Search Results" %>
      <% end %>
    </ul>
    <div id="new_tier" class="mt-3">
      <%= render partial: 'tiers/form', locals: { tier: Tier.new } %>
    </div>
  <% else %>
    <ul class="tier-stack space-y-2">
      <% @tiers.rank(:row_order).each do |tier| %>
        <%= render tier unless tier.title == "Search Results" %>
      <% end %>
    </ul>
  <% end %>
</section>

<% if owner %>
  <section class="card mt-10 p-5 sm:p-6">
    <%= render 'movies/search', locals: { user: @user, tier_list: @tier_list } %>
  </section>
<% end %>

<% provide(:title, "New tier list") %>
<div class="mx-auto max-w-lg py-6">
  <h1 class="page-title">New tier list</h1>
  <p class="mt-2 muted">You can add tiers and movies once it's created.</p>

  <div class="card mt-8 p-6 sm:p-8">
    <%= render "form", tier_list: @tier_list %>
  </div>

  <p class="mt-6 text-sm"><%= link_to "← Back to your tier lists", current_user, class: "link" %></p>
</div>

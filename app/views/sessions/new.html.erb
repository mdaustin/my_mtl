<% provide(:title, "Log in") %>
<div class="mx-auto max-w-md py-6">
  <div class="text-center">
    <h1 class="page-title">Welcome back</h1>
    <p class="mt-2 muted">Log in to keep ranking.</p>
  </div>

  <div class="card mt-8 p-6 sm:p-8">
    <%= form_with(url: login_path, scope: :session, class: "space-y-5") do |f| %>
      <div class="space-y-1.5">
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, placeholder: "you@example.com", autocomplete: "email", class: "field-input" %>
      </div>

      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <%= f.label :password, class: "field-label" %>
          <%= link_to 'Forgot password?', new_password_reset_path, class: 'link text-sm' %>
        </div>
        <%= f.password_field :password, placeholder: "••••••••", autocomplete: "current-password", class: "field-input" %>
      </div>

      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "field-checkbox" %>
        <%= f.label :remember_me, "Remember me", class: "text-sm text-zinc-700 dark:text-zinc-300" %>
      </div>

      <%= f.submit "Log in", class: "btn-primary w-full" %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm muted">New here? <%= link_to "Create an account", signup_path, class: 'link' %></p>
</div>

<% provide(:title, 'Reset password') %>

<div class="mx-auto max-w-md py-6">
  <div class="text-center">
    <h1 class="page-title">Choose a new password</h1>
  </div>

  <div class="card mt-8 p-6 sm:p-8">
    <%= form_with(model: @user, url: password_reset_path(params[:id]), class: "space-y-5") do |f|%>
      <%= render 'shared/error_messages', object: f.object %>

      <%= hidden_field_tag :email, @user.email %>

      <div class="space-y-1.5">
        <%= f.label :password, class: "field-label" %>
        <%= f.password_field :password, placeholder: "••••••••", autocomplete: "new-password", class: "field-input" %>
      </div>

      <div class="space-y-1.5">
        <%= f.label :password_confirmation, "Confirm password", class: "field-label" %>
        <%= f.password_field :password_confirmation, placeholder: "••••••••", autocomplete: "new-password", class: "field-input" %>
      </div>

      <%= f.submit "Reset password", class: "btn-primary w-full" %>
    <% end %>
  </div>
</div>

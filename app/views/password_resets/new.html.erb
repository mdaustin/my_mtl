<% provide(:title, "Forgot password") %>

<div class="mx-auto max-w-md py-6">
  <div class="text-center">
    <h1 class="page-title">Forgot your password?</h1>
    <p class="mt-2 muted">We'll email you a link to reset it.</p>
  </div>

  <div class="card mt-8 p-6 sm:p-8">
    <%= form_with(url: password_resets_path, scope: :password_reset, class: "space-y-5") do |f| %>
      <div class="space-y-1.5">
        <%= f.label :email, class: "field-label" %>
        <%= f.email_field :email, placeholder: "you@example.com", autocomplete: "email", class: "field-input" %>
      </div>

      <%= f.submit "Send reset link", class: "btn-primary w-full" %>
    <% end %>
  </div>

  <p class="mt-6 text-center text-sm muted"><%= link_to "Back to log in", login_path, class: 'link' %></p>
</div>
